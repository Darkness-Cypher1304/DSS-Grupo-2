// ============================================================================
// NeuroAlert · Schema Prisma
// ============================================================================
// Modelo de datos completo de la plataforma.
// Cada modelo está documentado con su propósito y consideraciones de seguridad.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// ENUMS
// ============================================================================

/// Roles del sistema (RBAC)
/// - PARENT: padre/cuidador. Acceso al M-CHAT-R y a hacer consultas.
/// - SPECIALIST: pediatra/psicólogo verificado. Responde consultas, publica contenido.
/// - ADMIN: administrador del sistema. Verifica especialistas, modera, audita.
enum UserRole {
  PARENT
  SPECIALIST
  ADMIN
}

/// Estado del usuario (ciclo de vida de la cuenta)
enum UserStatus {
  PENDING_VERIFICATION  // recién registrado, pendiente de verificar email
  ACTIVE                // activo y verificado
  SUSPENDED             // suspendido temporalmente por NeuroAlert
  LOCKED                // bloqueado por intentos de login fallidos
  INACTIVE              // baja aprobada (p.ej. especialista dado de baja); no accede, datos conservados
  DISABLED              // deshabilitado definitivamente por NeuroAlert; solo un admin lo restaura
  PENDING_DELETION      // el usuario solicitó eliminar su cuenta; en período de gracia
}

/// Estado de una solicitud de baja de especialista (SpecialistLeaveRequest)
enum LeaveRequestStatus {
  PENDING   // solicitada, esperando decisión del admin
  APPROVED  // aprobada → cuenta pasa a INACTIVE
  REJECTED  // rechazada (con nota)
}

/// Estado de verificación profesional del especialista
enum SpecialistVerificationStatus {
  NOT_REQUIRED  // para padres y admins
  PENDING       // documentos enviados, esperando revisión del admin
  APPROVED      // verificado y aprobado
  REJECTED      // rechazado
}

/// Estado de una POSTULACIÓN de especialista (MedicalApplication).
/// A diferencia de SpecialistVerificationStatus (que vive en el perfil de un
/// User YA existente), esto describe una solicitud que AÚN NO tiene cuenta.
enum ApplicationStatus {
  PENDING   // recibida, esperando revisión del admin
  APPROVED  // aprobada → se creó la cuenta + enlace de activación
  REJECTED  // rechazada (con motivo)
}

/// Estado del contenido educativo
enum ContentStatus {
  DRAFT       // borrador, solo el autor lo ve
  PENDING     // enviado a revisión del admin
  PUBLISHED   // publicado, visible para todos
  ARCHIVED    // archivado
}

/// Estado de una consulta padre→especialista
enum QuestionStatus {
  OPEN          // recién creada, esperando especialista
  ASSIGNED      // un especialista la tomó
  ANSWERED      // ya respondida
  CLOSED        // cerrada por el padre o por el sistema
}

/// Nivel de riesgo del cuestionario M-CHAT-R
/// Basado en el scoring oficial de Robins, Fein, & Barton (2009)
enum MchatRiskLevel {
  LOW       // 0-2 puntos: riesgo bajo, no se requiere acción adicional
  MEDIUM    // 3-7 puntos: riesgo medio, hacer seguimiento (M-CHAT-R/F)
  HIGH      // 8-20 puntos: riesgo alto, derivar inmediatamente a especialista
}

/// Tipo de acción auditada
enum AuditAction {
  USER_REGISTERED
  USER_LOGIN_SUCCESS
  USER_LOGIN_FAILED
  USER_LOGOUT
  USER_PASSWORD_CHANGED
  USER_EMAIL_VERIFIED
  USER_ROLE_CHANGED
  USER_STATUS_CHANGED
  SPECIALIST_VERIFIED
  SPECIALIST_REJECTED
  CONTENT_CREATED
  CONTENT_PUBLISHED
  CONTENT_DELETED
  QUESTION_CREATED
  QUESTION_ANSWERED
  MCHAT_COMPLETED
  RESOURCE_UPLOADED
  RESOURCE_DELETED
  ADMIN_ACTION
  SECURITY_ALERT
}

// ============================================================================
// MODELO: USER
// ============================================================================
// El núcleo del sistema. Almacena credenciales y metadatos.
// SEGURIDAD:
//   - id: CUID2 (no incremental, opaco — previene IDOR)
//   - passwordHash: bcrypt rounds=12 (NUNCA almacenar password en claro)
//   - email: citext (case-insensitive) y unique
//   - failedLoginAttempts + lockedUntil: previene brute force
//   - emailVerificationToken: para flujo de verificación
//   - relación con AuditLog para trazabilidad completa

model User {
  id                String     @id @default(cuid())
  email             String     @unique @db.Citext
  passwordHash      String
  fullName          String
  phoneNumber       String?

  role              UserRole   @default(PARENT)
  status            UserStatus @default(PENDING_VERIFICATION)

  // Verificación de email
  emailVerified              Boolean   @default(false)
  emailVerificationToken     String?   @unique
  emailVerificationExpiresAt DateTime?

  // Reset de contraseña
  passwordResetToken         String?   @unique
  passwordResetExpiresAt     DateTime?

  // Defensa contra brute force
  failedLoginAttempts        Int       @default(0)
  lockedUntil                DateTime?
  lastLoginAt                DateTime?
  lastLoginIp                String?

  // Solo para SPECIALIST
  specialistProfile          SpecialistProfile?

  // Ciclo de vida / baja de cuenta (Etapa 3)
  deletionRequestedAt DateTime? // inicio del período de gracia (autoeliminación)
  deletionReason      String?   @db.Text
  anonymizedAt        DateTime? // cuándo se anonimizó la PII (tras la gracia)

  // Timestamps
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime? // soft delete (no se borra realmente, se marca)

  // Relaciones
  refreshTokens       RefreshToken[]
  mchatScreenings     MchatScreening[]
  questionsAsked      Question[]      @relation("QuestionAuthor")
  questionsAssigned   Question[]      @relation("QuestionAssignedTo")
  answers             Answer[]
  contentCreated      Content[]
  resourcesUploaded   Resource[]
  auditLogs           AuditLog[]
  leaveRequest        SpecialistLeaveRequest?

  @@index([email])
  @@index([role, status])
  @@index([deletedAt])
  @@map("users")
}

// ============================================================================
// MODELO: SPECIALIST_LEAVE_REQUEST  (solicitud de baja del especialista)
// ============================================================================
// El especialista NO elimina su cuenta directamente: SOLICITA la baja. Un admin
// la revisa (valida que no queden responsabilidades pendientes) y, si la aprueba,
// la cuenta pasa a INACTIVE (no se borra; artículos/historial/auditoría se
// conservan). RLS: ENABLE + NO FORCE (el dueño + el admin; el control real en app).
model SpecialistLeaveRequest {
  id           String             @id @default(cuid())
  userId       String             @unique
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  reason       String             // motivo seleccionado
  comments     String?            @db.Text

  status       LeaveRequestStatus @default(PENDING)
  reviewedById String?            // admin que decidió
  reviewedAt   DateTime?
  decisionNote String?            @db.Text

  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([status, createdAt])
  @@map("specialist_leave_requests")
}

// ============================================================================
// MODELO: SPECIALIST_PROFILE
// ============================================================================
// Datos profesionales solo para usuarios con rol SPECIALIST.
// Separado en otra tabla para no inflar User y por Single Responsibility.

model SpecialistProfile {
  id                  String                       @id @default(cuid())
  userId              String                       @unique
  user                User                         @relation(fields: [userId], references: [id], onDelete: Cascade)

  licenseNumber       String                       @unique  // CMP/CPsP
  specialty           String                       // "Pediatría", "Psicología infantil", etc.
  institution         String?                      // hospital o clínica
  yearsOfExperience   Int

  bio                 String?                      @db.Text
  profilePhotoKey     String?                      // ruta en MinIO

  verificationStatus  SpecialistVerificationStatus @default(PENDING)
  verifiedAt          DateTime?
  verifiedById        String?                      // admin que aprobó
  rejectionReason     String?                      @db.Text

  // Documentos de validación (rutas en MinIO)
  licenseDocumentKey  String?
  cvDocumentKey       String?

  createdAt           DateTime                     @default(now())
  updatedAt           DateTime                     @updatedAt

  @@index([verificationStatus])
  @@map("specialist_profiles")
}

// ============================================================================
// MODELO: REFRESH_TOKEN
// ============================================================================
// Almacena los refresh tokens emitidos. Permite revocación selectiva.
// SEGURIDAD: el access token (15min) NO se almacena, solo el refresh (7d).
// Cuando se revoca, se invalida en Redis blacklist Y en esta tabla.

model RefreshToken {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique  // hash del token, no el token plano
  family      String                       // grupo de tokens del mismo "device"
  ipAddress   String?
  userAgent   String?
  expiresAt   DateTime
  revokedAt   DateTime?
  revokedReason String?
  createdAt   DateTime  @default(now())

  @@index([userId])
  @@index([tokenHash])
  @@index([family])
  @@map("refresh_tokens")
}

// ============================================================================
// MODELO: FAILED_LOGIN_ATTEMPT
// ============================================================================
// Registra todos los intentos fallidos de login para análisis de seguridad.
// Cumple con OWASP A09 (Security Logging Failures).

model FailedLoginAttempt {
  id          String   @id @default(cuid())
  email       String   @db.Citext  // puede ser email que NO existe
  ipAddress   String
  userAgent   String?
  reason      String   // "INVALID_PASSWORD", "USER_NOT_FOUND", "ACCOUNT_LOCKED"
  attemptedAt DateTime @default(now())

  @@index([email, attemptedAt])
  @@index([ipAddress, attemptedAt])
  @@map("failed_login_attempts")
}

// ============================================================================
// MODELO: CONTENT (Artículos educativos sobre TEA)
// ============================================================================
// Contenido educativo creado por especialistas y aprobado por admins.

model Content {
  id            String        @id @default(cuid())
  authorId      String
  author        User          @relation(fields: [authorId], references: [id])

  title         String
  slug          String        @unique
  summary       String        @db.VarChar(500)
  body          String        @db.Text
  category      String        // "Señales tempranas", "Diagnóstico", "Intervención", etc.
  tags          String[]
  coverImageKey String?       // ruta en MinIO

  status        ContentStatus @default(DRAFT)
  publishedAt   DateTime?

  // Métricas
  viewCount     Int           @default(0)

  // Moderación
  reviewedById  String?
  reviewNotes   String?       @db.Text

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  deletedAt     DateTime?

  @@index([status, publishedAt])
  @@index([authorId])
  @@index([slug])
  @@map("contents")
}

// ============================================================================
// MODELO: QUESTION (Consultas padre → especialista)
// ============================================================================

model Question {
  id              String         @id @default(cuid())
  authorId        String
  author          User           @relation("QuestionAuthor", fields: [authorId], references: [id])

  assignedToId    String?
  assignedTo      User?          @relation("QuestionAssignedTo", fields: [assignedToId], references: [id])

  title           String         @db.VarChar(200)
  body            String         @db.Text
  childAgeMonths  Int?           // edad del niño en meses (para contextualizar)
  isUrgent        Boolean        @default(false)
  isAnonymous     Boolean        @default(true)  // por defecto, anonimato del padre

  status          QuestionStatus @default(OPEN)

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  closedAt        DateTime?

  answers         Answer[]

  @@index([status])
  @@index([authorId])
  @@index([assignedToId])
  @@map("questions")
}

// ============================================================================
// MODELO: ANSWER
// ============================================================================

model Answer {
  id            String    @id @default(cuid())
  questionId    String
  question      Question  @relation(fields: [questionId], references: [id], onDelete: Cascade)
  specialistId  String
  specialist    User      @relation(fields: [specialistId], references: [id])

  body          String    @db.Text
  isAccepted    Boolean   @default(false)  // padre marca la respuesta como útil

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([questionId])
  @@index([specialistId])
  @@map("answers")
}

// ============================================================================
// MODELO: MCHAT_SCREENING
// ============================================================================
// Cuestionario M-CHAT-R (Modified Checklist for Autism in Toddlers, Revised).
// 20 preguntas validadas internacionalmente para tamizaje en niños 16-30 meses.
// Robins, Fein, & Barton (2009).

model MchatScreening {
  id              String         @id @default(cuid())
  parentId        String
  parent          User           @relation(fields: [parentId], references: [id])

  childName       String?        // opcional, padres pueden anonimizar
  childAgeMonths  Int            // 16-30 meses idealmente
  childGender     String?        // "M", "F", "OTHER", null

  // Las 20 respuestas (true = respuesta de riesgo)
  // Cada pregunta tiene una respuesta "esperada"; si difiere, suma puntos.
  // Almacenamos como JSON para flexibilidad pero validamos estrictamente.
  responses       Json           // { "q1": true/false, "q2": ..., ..., "q20": ... }

  // Resultado calculado en el servidor (no en cliente — Zero Trust)
  totalScore      Int            // 0-20
  riskLevel       MchatRiskLevel

  // Recomendaciones generadas (snapshot en el momento de la evaluación)
  recommendations String         @db.Text

  // Si el padre quiere convertir la evaluación en una consulta a especialista
  followUpQuestionId String?

  createdAt       DateTime       @default(now())

  @@index([parentId, createdAt])
  @@index([riskLevel])
  @@map("mchat_screenings")
}

// ============================================================================
// MODELO: RESOURCE (PDFs, imágenes, recursos descargables)
// ============================================================================

model Resource {
  id            String    @id @default(cuid())
  uploaderId    String
  uploader      User      @relation(fields: [uploaderId], references: [id])

  title         String
  description   String?   @db.Text
  category      String

  fileKey       String    @unique  // ruta en MinIO
  fileName      String              // nombre original
  fileSize      Int                 // bytes
  mimeType      String              // validado contra magic bytes
  fileHash      String              // SHA-256 para verificar integridad

  isPublic      Boolean   @default(false)
  downloadCount Int       @default(0)

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  @@index([category, isPublic])
  @@index([uploaderId])
  @@map("resources")
}

// ============================================================================
// MODELO: AUDIT_LOG
// ============================================================================
// Tabla INSERT-only. NUNCA se actualiza ni borra.
// Implementa el principio de Separation: ni el desarrollador puede borrar
// su rastro de auditoría. La política RLS lo refuerza a nivel de BD.

model AuditLog {
  id          String      @id @default(cuid())
  userId      String?     // null si la acción fue del sistema o un atacante anónimo
  user        User?       @relation(fields: [userId], references: [id])

  action      AuditAction
  entityType  String?     // "User", "Content", "Question", etc.
  entityId    String?     // ID del recurso afectado

  // Contexto de seguridad
  ipAddress   String
  userAgent   String?

  // Resultado: true = exitoso, false = fallido
  success     Boolean     @default(true)

  // Detalles adicionales en JSON (no incluir datos sensibles!)
  metadata    Json?

  createdAt   DateTime    @default(now())

  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

// ============================================================================
// MODELO: FILE_OBJECT  (almacenamiento de archivos en PostgreSQL — RF-25..28)
// ============================================================================
// Reemplaza MinIO (no disponible en Render free-tier) SIN añadir servicios.
// Guarda el binario (bytea) + metadatos verificados por el servidor:
//   - mimeType contra whitelist + magic-bytes validados ANTES de persistir (RF-26)
//   - sha256 de integridad (RF-27)
//   - sizeBytes (tope configurable)
// La descarga emula "presigned URLs" con tokens HMAC efímeros (RF-25/28).
// `ownerId` es escalar a propósito (sin relación) para no tocar el modelo User.
model FileObject {
  id          String   @id @default(cuid())
  folder      String   // 'specialist-docs' | 'resources' | 'avatars'
  fileName    String   // nombre original sanitizado
  mimeType    String
  sizeBytes   Int
  sha256      String
  data        Bytes    // contenido binario (bytea)
  ownerId     String?  // usuario que subió el archivo

  createdAt   DateTime @default(now())

  @@index([ownerId])
  @@index([folder])
  @@map("file_objects")
}

// ============================================================================
// MODELO: NOTIFICATION  (notificaciones in-app por polling — RF-34)
// ============================================================================
// Sin WebSocket (Render free-tier no lo sostiene): el frontend hace polling
// del contador/listado. La notificación se crea a NIVEL SISTEMA cuando ocurre
// el evento (p.ej. un especialista responde una consulta → se notifica al padre).
//   - userId: destinatario. Escalar a propósito (sin relación) — mismo criterio
//     que FileObject — para no tocar el modelo User.
//   - type: discriminador de evento ('ANSWER', etc.).
//   - relatedType/relatedId: enlace opaco al recurso origen (p.ej. Question/<id>),
//     sin foreign key para no forzar cascadas ni acoplar el modelo.
// RLS: ENABLE + NO FORCE (igual que el resto). El control real vive en la capa
// app (el service filtra SIEMPRE por userId); las políticas son defensa en
// profundidad para conexiones de roles NO-dueños.
model Notification {
  id          String   @id @default(cuid())
  userId      String   // destinatario
  type        String   // 'ANSWER' | ... (discriminador del evento)
  title       String
  body        String?  @db.Text
  relatedType String?  // 'Question' | ... (tipo del recurso de origen)
  relatedId   String?  // id del recurso de origen (enlace opaco, sin FK)
  isRead      Boolean  @default(false)

  createdAt   DateTime @default(now())

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@map("notifications")
}

// ============================================================================
// MODELO: MEDICAL_APPLICATION  (postulación de especialista — SIN cuenta)
// ============================================================================
// El especialista NO se "registra": POSTULA. Al enviar el formulario NO se crea
// ningún User, contraseña ni sesión — solo esta solicitud en estado PENDING.
// La cuenta (User rol SPECIALIST) se crea SOLO cuando un ADMIN aprueba, dentro
// de una transacción atómica, y el especialista define su contraseña vía un
// enlace de activación de un solo uso (nunca se envía contraseña por correo).
// SEGURIDAD (§9 del flujo): se guardan hash SHA-256 de los documentos, fecha e
// IP de la solicitud; toda aprobación/rechazo queda en el AuditLog (quién/cuándo/IP).
// RLS: ENABLE + NO FORCE (igual que el resto). El control real vive en la capa
// app; el INSERT es público (postulación anónima), el resto es solo ADMIN.
model MedicalApplication {
  id                  String            @id @default(cuid())

  // Datos personales y profesionales (pantalla 9.5)
  firstName           String
  lastName            String
  email               String            @db.Citext
  phoneNumber         String
  licenseNumber       String            // colegiatura (CMP/CPsP)
  specialty           String
  university          String
  country             String

  // Documentos (referencias a FileObject) + integridad (RF-26/27, §9)
  cvFileId            String
  cvSha256            String
  dniFileId           String
  dniSha256           String
  linkedinUrl         String?           // opcional

  // Perfil profesional
  yearsOfExperience   Int               @default(0)
  availability        String            @db.Text
  motivationLetter    String            @db.Text

  // Consentimiento + contexto de seguridad (§9: fecha + IP de la solicitud)
  consentAccepted     Boolean           @default(false)
  submittedIp         String
  submittedUserAgent  String?

  // Revisión del administrador
  status              ApplicationStatus @default(PENDING)
  reviewedById        String?           // admin que decidió
  reviewedAt          DateTime?
  rejectionReason     String?           @db.Text
  checklist           Json?             // snapshot del checklist marcado al aprobar

  // Activación de la cuenta (se llena SOLO al aprobar)
  createdUserId       String?           @unique  // User creado tras la aprobación
  activationToken     String?           @unique  // token de un solo uso (24 h)
  activationExpiresAt DateTime?

  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@index([status, createdAt])
  @@index([email])
  @@index([licenseNumber])
  @@map("medical_applications")
}
