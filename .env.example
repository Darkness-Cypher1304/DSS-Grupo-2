# ============================================================================
# NeuroAlert · Variables de entorno
# ============================================================================
# COPIA ESTE ARCHIVO COMO .env Y RELLENA LOS VALORES.
# NUNCA subas .env al repositorio — solo .env.example.
# ============================================================================

# ----------------------------------------------------------------------------
# ENTORNO
# ----------------------------------------------------------------------------
NODE_ENV=development

# ----------------------------------------------------------------------------
# BASE DE DATOS · PostgreSQL 16
# ----------------------------------------------------------------------------
POSTGRES_USER=neuroalert
POSTGRES_PASSWORD=neuroalert_dev_2026_change_in_prod
POSTGRES_DB=neuroalert
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Connection string que usa Prisma (NestJS)
DATABASE_URL="postgresql://neuroalert:neuroalert_dev_2026_change_in_prod@postgres:5432/neuroalert?schema=public"

# Usuario de SOLO LECTURA para reportes / dashboards (Least Privilege)
DATABASE_URL_READONLY="postgresql://neuroalert_ro:readonly_dev_2026@postgres:5432/neuroalert?schema=public"

# ----------------------------------------------------------------------------
# REDIS · cache + JWT blacklist + rate limiting
# ----------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis_dev_2026_change_in_prod
REDIS_URL="redis://:redis_dev_2026_change_in_prod@redis:6379"

# ----------------------------------------------------------------------------
# JWT · firma asimétrica RS256
# ----------------------------------------------------------------------------
# IMPORTANTE: estos secrets son SOLO para desarrollo. En producción deben
# generarse con `openssl rand -base64 64` y almacenarse en un gestor seguro.
JWT_ACCESS_SECRET=dev_access_secret_change_me_64_chars_minimum_aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
JWT_REFRESH_SECRET=dev_refresh_secret_change_me_64_chars_minimum_bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
JWT_ISSUER=neuroalert
JWT_AUDIENCE=neuroalert-users

# ----------------------------------------------------------------------------
# CORS / FRONTEND
# ----------------------------------------------------------------------------
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000

# Cookie settings (refresh token)
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false   # true en producción (requiere HTTPS)
COOKIE_SAMESITE=strict
COOKIE_SECRET=dev_cookie_secret_change_me_at_least_32_chars_long_aaaaaaaaaaa
SESSION_SECRET=dev_session_secret_change_me_at_least_32_chars_long_aaaaaaaa

# ----------------------------------------------------------------------------
# RATE LIMITING (por IP)
# ----------------------------------------------------------------------------
THROTTLE_TTL=60          # ventana de 60 segundos
THROTTLE_LIMIT=100       # 100 requests por ventana global
THROTTLE_AUTH_LIMIT=10   # 10 requests por ventana en /auth/*

# ----------------------------------------------------------------------------
# RESEND · servicio de correos transaccionales (gratis, 3000/mes, 100/día)
# ----------------------------------------------------------------------------
# DEJA VACÍO para usar el modo "consola" (los correos se imprimen en logs).
# Para activar Resend:
#   1) Crea cuenta en https://resend.com (gratis)
#   2) Copia tu API Key desde https://resend.com/api-keys
#   3) Pégala abajo
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_FROM_NAME=NeuroAlert

# ----------------------------------------------------------------------------
# MINIO · storage S3-compatible para PDFs y recursos
# ----------------------------------------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minio_dev_2026_change_in_prod
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_BUCKET_NAME=neuroalert-resources
MINIO_PRESIGNED_URL_TTL=900  # 15 minutos

# ----------------------------------------------------------------------------
# FRONTEND · Next.js (públicas — empiezan con NEXT_PUBLIC_)
# ----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_NAME=NeuroAlert
NEXT_PUBLIC_APP_DESCRIPTION="Detección temprana del TEA"

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=dev_nextauth_secret_change_me_at_least_32_chars_long_aaaaaaaaaaa

# ----------------------------------------------------------------------------
# OBSERVABILIDAD
# ----------------------------------------------------------------------------
LOG_LEVEL=debug    # debug | info | warn | error
LOG_FORMAT=pretty  # pretty (dev) | json (prod)

# ----------------------------------------------------------------------------
# SEGURIDAD AVANZADA
# ----------------------------------------------------------------------------
BCRYPT_ROUNDS=12              # 12 en dev, 14 en prod
MAX_LOGIN_ATTEMPTS=5          # bloqueo tras 5 intentos fallidos
LOGIN_LOCKOUT_DURATION=900    # 15 minutos en segundos
PASSWORD_MIN_LENGTH=12        # contraseñas largas, no necesariamente complejas
SESSION_IDLE_TIMEOUT=1800     # 30 minutos de inactividad
