# ============================================================================
# NeuroAlert · Backend (API) — plantilla de variables de entorno
# ============================================================================
# Copia este archivo como `.env` y rellena los valores. NUNCA subas tu `.env`
# (está en .gitignore); este `.env.example` es el ÚNICO que se versiona.
#
# - Los VALORES de abajo son de EJEMPLO para desarrollo local; no son secretos
#   reales. En la nube (Render) las variables se configuran por servicio.
# - Cada variable listada aquí es leída por el código (ConfigService). Las
#   marcadas [REQUERIDA] son imprescindibles para arrancar; el resto tiene
#   valor por defecto o es opcional (funcionalidad concreta).
# ============================================================================

# ----------------------------------------------------------------------------
# ENTORNO
# ----------------------------------------------------------------------------
NODE_ENV=development          # development | production | test
PORT=4000                     # puerto HTTP (en Render lo asigna la plataforma)
LOG_LEVEL=debug               # debug | info | warn | error

# ----------------------------------------------------------------------------
# BASE DE DATOS · PostgreSQL (Prisma)                               [REQUERIDA]
# ----------------------------------------------------------------------------
DATABASE_URL="postgresql://usuario:password@localhost:5432/neuroalert?schema=public"

# ----------------------------------------------------------------------------
# JWT                                          [REQUERIDAS: los dos *_SECRET]
# ----------------------------------------------------------------------------
# Genera cada secreto con:  openssl rand -base64 48   (mínimo 32 caracteres)
JWT_ACCESS_SECRET=cambia_esto_por_un_secreto_de_minimo_32_caracteres_aaaa
JWT_REFRESH_SECRET=cambia_esto_por_otro_secreto_de_minimo_32_caracteres_bb
JWT_ACCESS_EXPIRATION=15m
JWT_ACCESS_EXPIRATION_SECONDS=900
JWT_REFRESH_EXPIRATION=7d
JWT_ISSUER=neuroalert
JWT_AUDIENCE=neuroalert-users

# ----------------------------------------------------------------------------
# CORS / FRONTEND
# ----------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000     # orígenes permitidos, separados por comas
FRONTEND_URL=http://localhost:3000     # base para los enlaces de los correos

# ----------------------------------------------------------------------------
# COOKIES (refresh token en cookie HttpOnly)
# ----------------------------------------------------------------------------
COOKIE_SECURE=false           # true en producción (requiere HTTPS)
COOKIE_SAMESITE=lax           # lax | strict | none
COOKIE_DOMAIN=                # vacío en local; el dominio en producción

# ----------------------------------------------------------------------------
# CORREO
# ----------------------------------------------------------------------------
# En producción se envía por la API HTTP de Brevo (Render bloquea SMTP).
BREVO_API_KEY=                # requerida para enviar correos en la nube
BREVO_FROM_EMAIL=no-reply@neuroalert.pe
# Fallback SMTP (solo local; opcional). Si se deja vacío no se usa.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Alternativa Resend (opcional). Si se deja vacío no se usa.
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_FROM_NAME=NeuroAlert

# ----------------------------------------------------------------------------
# RATE LIMITING (Throttler, por IP)
# ----------------------------------------------------------------------------
THROTTLE_TTL=60               # ventana en segundos
THROTTLE_LIMIT=100            # nº de peticiones por ventana

# ----------------------------------------------------------------------------
# SEGURIDAD / AUTENTICACIÓN
# ----------------------------------------------------------------------------
BCRYPT_ROUNDS=12              # coste de bcrypt
MAX_LOGIN_ATTEMPTS=5         # bloqueo de cuenta tras N intentos fallidos
LOGIN_LOCKOUT_DURATION=900    # duración del bloqueo, en segundos

# ----------------------------------------------------------------------------
# ALMACENAMIENTO DE ARCHIVOS (guardados en PostgreSQL, no en S3/MinIO)
# ----------------------------------------------------------------------------
STORAGE_MAX_BYTES=10485760    # tamaño máximo por archivo (10 MB)
STORAGE_TOKEN_SECRET=         # firma de las URLs de descarga; si vacío, usa JWT_ACCESS_SECRET

# ----------------------------------------------------------------------------
# CICLO DE VIDA DE CUENTAS
# ----------------------------------------------------------------------------
ACCOUNT_DELETION_GRACE_DAYS=30
# Secreto compartido con el workflow programado (GitHub Actions) que procesa las
# bajas vencidas. Opcional: si no se configura, el endpoint
# /api/users/system/process-deletions queda inerte (no se puede invocar).
CRON_SECRET=

# ----------------------------------------------------------------------------
# REDIS (OPCIONAL)
# ----------------------------------------------------------------------------
# Sin estas variables el backend usa un almacén EN MEMORIA (válido para una
# sola instancia). Descoméntalas solo si tienes un Redis disponible.
# REDIS_URL="redis://:password@localhost:6379"
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
